<% content_for :title, "Novo projeto · Repo2Ad" %>

<ol class="mb-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft" aria-label="Etapas">
  <li class="font-semibold text-ink" aria-current="step">1 Repositório</li>
  <li>2 Público</li>
  <li>3 Criativos</li>
  <li>4 Resultado</li>
</ol>

<h1 class="max-w-[18ch] text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">Qual repositório vamos anunciar?</h1>
<p class="mt-5 max-w-[56ch] text-lg leading-relaxed text-ink-soft">
  Cole o link público do GitHub. A gente lê o código, entende o produto e sugere para quem vender.
</p>

<% url_error = @project.errors[:repo_url].first %>
<% photos_error = @project.errors[:photos].first %>

<div class="crop-marks mt-14 bg-sheet p-6 sm:p-10">
  <%= form_with model: @project, url: projects_path, class: "space-y-8" do |f| %>
    <div class="min-w-0">
      <%= f.label :repo_url, "Link do repositório", class: "block text-base font-semibold" %>
      <%= f.text_field :repo_url, inputmode: "url", autocomplete: "off", spellcheck: false,
            placeholder: "https://github.com/dono/repositorio",
            aria: { invalid: url_error.present?, describedby: [ "repo_url_hint", ("repo_url_error" if url_error) ].compact.join(" ") },
            class: [ "mt-3 w-full border-b-2 bg-transparent py-3 text-lg placeholder:text-ink-soft/70 focus:outline-none",
                     url_error ? "border-magenta" : "border-ink" ] %>
      <% if url_error %>
        <p id="repo_url_error" role="alert" class="mt-2 text-sm font-semibold text-magenta"><%= url_error %></p>
      <% end %>
      <p id="repo_url_hint" class="mt-2 text-sm text-ink-soft">Também aceita <code class="wrap-anywhere">git@github.com:dono/repositorio.git</code>.</p>
    </div>

    <div class="min-w-0">
      <p id="photos_label" class="text-base font-semibold">Fotos reais do produto <span class="font-normal text-ink-soft">(opcional)</span></p>
      <label data-controller="dropzone"
             data-action="dragover->dropzone#over dragleave->dropzone#leave drop->dropzone#drop"
             class="mt-3 grid min-h-36 cursor-pointer place-items-center border-2 border-dashed px-4 py-8 text-center text-ink-soft transition-colors has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-3 has-[:focus-visible]:outline-magenta <%= photos_error ? "border-magenta" : "border-rule" %>">
        <span class="wrap-anywhere">Arraste até 8 fotos aqui ou toque para escolher. JPG, PNG ou HEIC.<br>
          <span class="text-sm">Ajudam em anúncios de antes e depois.</span></span>
        <span data-dropzone-target="list" aria-live="polite" class="mt-3 text-sm font-semibold text-ink"></span>
        <%= f.file_field :photos, multiple: true, aria: { labelledby: "photos_label" },
              accept: "image/jpeg,image/png,image/heic,image/heif,.jpg,.jpeg,.png,.heic,.heif",
              class: "sr-only", data: { dropzone_target: "input", action: "change->dropzone#show" } %>
      </label>
      <% if photos_error %>
        <p role="alert" class="mt-2 text-sm font-semibold text-magenta"><%= photos_error %></p>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <%= f.submit "Analisar repositório", class: "cursor-pointer bg-ink px-6 py-3 font-semibold text-sheet hover:bg-magenta" %>
    </div>
  <% end %>
</div>
