<div id="<%= dom_id(project, :results_summary) %>" class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-lg text-ink-soft" role="status">
  <% if creatives.any? { !_1.finished? } %>
    <span class="size-2.5 animate-pulse rounded-full bg-magenta" aria-hidden="true"></span>
  <% end %>
  <span><%= creatives.any? ? results_summary(creatives) : "Nada gerado ainda" %></span>
  <% if creatives.any? && creatives.all?(&:finished?) %>
    <span class="font-semibold text-ink">Tudo pronto para revisar.</span>
  <% end %>
</div>
