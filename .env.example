# Copie para .env e preencha. O .env nunca é commitado.

# Raciocínio (P1–P5) via OpenRouter.
OPENROUTER_API_KEY=

# Opcional: aumenta o limite da API do GitHub (60 req/h sem token).
GITHUB_TOKEN=

# Active Record encryption keys (protect the Higgsfield OAuth tokens). Generate with:
#   ruby -rsecurerandom -e '3.times { puts SecureRandom.alphanumeric(32) }'
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# Higgsfield MCP: click "Conectar Higgsfield" in the app to log in (OAuth).
# Optional: OAuth redirect URI. Default: http://localhost:${PORT}/higgsfield/callback
HF_MCP_REDIRECT_URI=
